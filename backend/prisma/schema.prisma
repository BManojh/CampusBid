generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum ListingStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
  UNSOLD
}

enum TransactionStatus {
  PENDING
  ACCEPTED
  REJECTED
  HANDOVER_SCHEDULED
  COMPLETED
  CANCELLED
}

enum NotificationType {
  OUTBID
  AUCTION_CLOSED
  SELLER_DECISION
  HANDOVER_UPDATE
  SYSTEM
}

enum SellerDecision {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model User {
  id                 String         @id @default(uuid())
  name               String
  email              String         @unique
  passwordHash       String
  role               UserRole       @default(BUYER)
  accountStatus      AccountStatus  @default(ACTIVE)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  listings           Listing[]      @relation("SellerListings")
  bids               Bid[]
  buyerTransactions  Transaction[]  @relation("BuyerTransactions")
  sellerTransactions Transaction[]  @relation("SellerTransactions")
  notifications      Notification[]
  questions          Question[]     @relation("QuestionAuthor")
  savedSearches      SavedSearch[]
  autoBids           AutoBid[]
  auctionResults     AuctionResult[] @relation("AuctionWinner")
  auditLogs           AuditLog[]     @relation("AuditActor")
}

model Listing {
  id                    String        @id @default(uuid())
  sellerId              String
  title                 String
  category              String
  description           String
  condition             String
  startingPricePaise    Int
  minimumIncrementPaise Int
  currentBidPaise       Int?
  auctionEndsAt         DateTime
  status                ListingStatus @default(OPEN)
  winnerBidId           String?       @unique
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  seller                User          @relation("SellerListings", fields: [sellerId], references: [id])
  bids                  Bid[]
  winnerBid             Bid?          @relation("WinningBid", fields: [winnerBidId], references: [id])
  transaction           Transaction?
  images                ListingImage[]
  auctionResult         AuctionResult?
  questions             Question[]
  autoBids              AutoBid[]

  @@index([status, auctionEndsAt])
  @@index([category, status])
  @@index([sellerId])
}

model Bid {
  id          String   @id @default(uuid())
  listingId   String
  bidderId    String
  amountPaise Int
  createdAt   DateTime @default(now())
  idempotencyKey String?
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidder      User     @relation(fields: [bidderId], references: [id])
  winningFor  Listing? @relation("WinningBid")
  auctionWinningResult AuctionResult? @relation("AuctionWinningBid")

  @@index([listingId, amountPaise, createdAt])
  @@index([bidderId])
  @@unique([bidderId, idempotencyKey])
}

model AutoBid {
  id          String   @id @default(uuid())
  listingId   String
  bidderId    String
  maxPaise    Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidder      User     @relation(fields: [bidderId], references: [id], onDelete: Cascade)

  @@unique([listingId, bidderId])
  @@index([listingId, active, maxPaise])
}

model Question {
  id         String   @id @default(uuid())
  listingId  String
  authorId   String
  body       String
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  author     User     @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
}

model SavedSearch {
  id              String   @id @default(uuid())
  userId          String
  name            String
  query           String?
  category        String?
  maxPricePaise   Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Transaction {
  id               String            @id @default(uuid())
  listingId        String            @unique
  buyerId          String
  sellerId         String
  status           TransactionStatus @default(PENDING)
  sellerDecision   SellerDecision    @default(PENDING)
  decisionDeadline DateTime?
  buyerConfirmedAt DateTime?
  sellerConfirmedAt DateTime?
  sellerResponseAt DateTime?
  handoverAt       DateTime?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  listing          Listing           @relation(fields: [listingId], references: [id])
  buyer            User              @relation("BuyerTransactions", fields: [buyerId], references: [id])
  seller           User              @relation("SellerTransactions", fields: [sellerId], references: [id])

  @@index([buyerId, status])
  @@index([sellerId, status])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  entityId  String?
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime          @default(now())
  dedupeKey String?           @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model ListingImage {
  id         String   @id @default(uuid())
  listingId  String
  url        String
  publicId   String?
  createdAt  DateTime @default(now())
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model AuctionResult {
  id              String   @id @default(uuid())
  listingId       String   @unique
  winningBidId    String?  @unique
  winnerId        String?
  finalizedAt     DateTime @default(now())
  hasWinner       Boolean  @default(false)
  listing         Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  winningBid      Bid?     @relation("AuctionWinningBid", fields: [winningBidId], references: [id])
  winner          User?    @relation("AuctionWinner", fields: [winnerId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String
  action      String
  entityType  String
  entityId    String
  reason      String?
  createdAt   DateTime @default(now())
  actor       User     @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
}
